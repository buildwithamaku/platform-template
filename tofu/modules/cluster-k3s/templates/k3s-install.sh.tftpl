#!/usr/bin/env bash
# Rendered per-node by OpenTofu (templatefile). Do not edit on the server.
#   $${...} tokens are substituted by OpenTofu; $VARS are expanded by bash at runtime.
set -euo pipefail

command -v curl >/dev/null 2>&1 || { apt-get update && apt-get install -y curl; }

NODE_IP="${node_ip}"

# The private NIC gets its IP a moment after boot; wait for it, then find its name
# so we can pin flannel + the node IP to the private network.
for _ in $(seq 1 60); do
  ip -o -4 addr show | grep -qw "$NODE_IP" && break
  sleep 2
done
PRIVATE_IFACE=$(ip -o -4 addr show | awk -v ip="$NODE_IP" '$4 ~ "^"ip"/" {print $2; exit}')

mkdir -p /etc/rancher/k3s
cat > /etc/rancher/k3s/config.yaml <<EOF
token: "${k3s_token}"
node-ip: "$NODE_IP"
flannel-iface: "$PRIVATE_IFACE"
write-kubeconfig-mode: "0644"
tls-san:
  - "${api_lb_ip}"
  - "$NODE_IP"
disable:
  - traefik
  - servicelb
%{ if install_hcloud_ccm ~}
# Run with the external cloud provider so hcloud-cloud-controller-manager owns
# node init + LoadBalancer provisioning. Every node carries the "uninitialized"
# taint until the CCM (staged below on the init node) clears it.
disable-cloud-controller: true
kubelet-arg:
  - "cloud-provider=external"
%{ endif ~}
%{ if is_init ~}
cluster-init: true
%{ else ~}
server: "https://${api_lb_ip}:6443"
%{ endif ~}
EOF

%{ if !is_init ~}
# Wait until the first server's API is reachable through the LB before joining.
until timeout 2 bash -c "echo > /dev/tcp/${api_lb_ip}/6443" 2>/dev/null; do
  sleep 4
done
%{ endif ~}

%{ if is_init && install_hcloud_ccm ~}
# Pre-stage hcloud CCM so k3s auto-applies it on first start. Raw manifests (not
# a k3s HelmChart) on purpose: a helm-install Job would be unschedulable under
# the "uninitialized" taint, deadlocking the very controller meant to clear it.
# The CCM Deployment itself tolerates that taint, so it schedules and initializes
# the nodes.
#
# ccm-networks.yaml (network-aware): the `hcloud` Secret carries the private
# network name, so CCM attaches ingress LoadBalancers to it and targets nodes by
# PRIVATE IP — matching the Phase-1 API LB and bypassing the public firewall.
# NOTE (prod hardening): with server_count > 1, CCM's route controller and
# flannel both touch pod routing; on multi-node prod, disable CCM routes
# (HCLOUD_NETWORK_ROUTES_ENABLED=false) or switch flannel-backend. Single-node
# staging has no inter-node routes, so it is unaffected. Validate on apply.
mkdir -p /var/lib/rancher/k3s/server/manifests
cat > /var/lib/rancher/k3s/server/manifests/hcloud-ccm-secret.yaml <<EOF
apiVersion: v1
kind: Secret
metadata:
  name: hcloud
  namespace: kube-system
stringData:
  token: "${hcloud_token}"
  network: "${network_name}"
EOF
# Retry so a transient GitHub blip doesn't abort the whole boot (set -euo
# pipefail) and cost the node. With cloud-provider=external the node stays
# NotReady until CCM lands, so fail loudly if the download truly never succeeds.
CCM_DEST=/var/lib/rancher/k3s/server/manifests/hcloud-ccm.yaml
CCM_URL="https://github.com/hetznercloud/hcloud-cloud-controller-manager/releases/download/${hcloud_ccm_version}/ccm-networks.yaml"
for _ in $(seq 1 30); do
  curl -sfL "$CCM_URL" -o "$CCM_DEST" && break
  sleep 5
done
test -s "$CCM_DEST" || { echo "FATAL: hcloud CCM download failed: $CCM_URL" >&2; exit 1; }
%{ endif ~}

curl -sfL https://get.k3s.io | INSTALL_K3S_VERSION="${k3s_version}" sh -s - server
