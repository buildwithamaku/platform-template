# Copy to terraform.tfvars (git-ignored) and fill in.
# hcloud_token is better supplied as TF_VAR_hcloud_token in your shell/CI secret.

# hcloud_token = "xxxxxxxx"   # prefer: export TF_VAR_hcloud_token=...

ssh_public_keys = [
  # "ssh-ed25519 AAAA... you@laptop",
]

# Lock the API + SSH to your IP. Find it with: curl -s ifconfig.me
api_allowed_cidrs = [
  # "203.0.113.7/32",
]
