# Reusable delivery workflow (D-06/D-10). App repos call this via workflow_call:
# it builds+tests+scans+pushes the image, then (as the [< registry_org >]-deployer
# GitHub App) commits the immutable image-digest bump to this platform repo's staging overlay.
# App repos NEVER touch a cluster; every deploy is an explicit git commit here.
name: build-and-bump

on:
  workflow_call:
    inputs:
      app:
        description: "overlay dir under clusters/apps/<app>/overlays/staging"
        required: true
        type: string
      image:
        description: "ghcr image repo, e.g. ghcr.io/[< registry_org >]/[< client_name >]-backend"
        required: true
        type: string
      language:
        description: "optional host test steps: container (Dockerfile only) | go | node"
        required: false
        type: string
        default: container
      context:
        description: "docker build context (a monorepo passes the service subdir, e.g. frontend). build-push uses <context>/Dockerfile."
        required: false
        type: string
        default: "."
      platform_repo:
        required: false
        type: string
        default: [< registry_org >]/[< platform_repo >]
    secrets:
      deployer_app_id:
        required: true
      deployer_private_key:
        required: true

jobs:
  build:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    outputs:
      digest: ${{ steps.build.outputs.digest }}
    steps:
      - uses: actions/checkout@v4
      - id: tag
        run: echo "tag=sha-$(git rev-parse --short=7 HEAD)" >> "$GITHUB_OUTPUT"
      # ── containerized-only contract: every app ships its own Dockerfile at the
      # build context. This platform builds container images only — there is no
      # Nixpacks/buildpack fallback (deliberate: pinned base image, non-root,
      # auditable layers). Fail fast with a clear message instead of a cryptic
      # buildx error deep in the run.
      - name: Validate delivery inputs and Dockerfile
        env:
          BUILD_CONTEXT: ${{ inputs.context }}
          APP: ${{ inputs.app }}
          LANGUAGE: ${{ inputs.language }}
        run: |
          case "$APP" in backend|frontend) ;; *) echo "::error::invalid app"; exit 1;; esac
          case "$LANGUAGE" in container|go|node) ;; *) echo "::error::invalid language"; exit 1;; esac
          python3 - <<'PYCODE'
          import os
          from pathlib import Path
          root = Path.cwd().resolve()
          context = Path(os.environ["BUILD_CONTEXT"])
          resolved = (root / context).resolve()
          if context.is_absolute() or not resolved.is_relative_to(root):
              raise SystemExit("Build context must remain within the checkout")
          if not (resolved / "Dockerfile").is_file():
              raise SystemExit("Containerized apps require a Dockerfile in the build context")
          PYCODE
      - name: gitleaks (blocking secret scan)
        run: |
          V=8.21.2
          curl -sSfL "https://github.com/gitleaks/gitleaks/releases/download/v${V}/gitleaks_${V}_linux_x64.tar.gz" | tar -xz gitleaks
          ./gitleaks detect --no-banner --redact --exit-code 1
      # Container mode delegates builds to the Dockerfile; app CI owns its tests.
      - if: inputs.language == 'go'
        uses: actions/setup-go@v5
        with:
          go-version: "[< go_version >]"
      - if: inputs.language == 'go'
        working-directory: ${{ inputs.context }}
        run: go vet ./... && go test ./...
      - if: inputs.language == 'node'
        uses: actions/setup-node@v4
        with:
          node-version: "[< node_version >]"
      - if: inputs.language == 'node'
        working-directory: ${{ inputs.context }}
        run: |
          npm ci
          npm run build --if-present
          npm test --if-present
      # ── package + push ──
      - uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}
      - id: build
        uses: docker/build-push-action@v6
        with:
          context: ${{ inputs.context }} # <context>/Dockerfile is the default build file
          push: true
          tags: ${{ inputs.image }}:${{ steps.tag.outputs.tag }}

  bump:
    needs: build
    runs-on: ubuntu-latest
    steps:
      - uses: actions/create-github-app-token@v1
        id: apptoken
        with:
          app-id: ${{ secrets.deployer_app_id }}
          private-key: ${{ secrets.deployer_private_key }}
          owner: [< registry_org >]
          repositories: [< platform_repo >]
      - uses: actions/checkout@v4
        with:
          repository: ${{ inputs.platform_repo }}
          token: ${{ steps.apptoken.outputs.token }}
      - name: Install kustomize (pinned)
        run: |
          curl -sSfL "https://raw.githubusercontent.com/kubernetes-sigs/kustomize/master/hack/install_kustomize.sh" \
            | bash -s 5.4.3
          sudo mv kustomize /usr/local/bin/
      # ENFORCEMENT (runbook): the staging/prod boundary here is that this
      # workflow only edits overlays/staging — the deployer App has repo-wide
      # contents:write (GitHub can't scope below repo). Real protection —
      # protected main + the `production` environment's required reviewers —
      # needs a public repo or a paid tier; on a private free plan those APIs
      # 403 and cannot be enabled. When you harden: add [< registry_org >]-deployer
      # to the branch-protection bypass list or these staging pushes start failing.
      - name: Bump staging digest + commit (rebase-retry, no-op safe)
        env:
          APP: ${{ inputs.app }}
          IMAGE: ${{ inputs.image }}
          DIGEST: ${{ needs.build.outputs.digest }}
          APP_SLUG: ${{ steps.apptoken.outputs.app-slug }}
        run: |
          git config user.name "${APP_SLUG}[bot]"
          git config user.email "${APP_SLUG}[bot]@users.noreply.github.com"
          [[ "$DIGEST" =~ ^sha256:[a-f0-9]{64}$ ]] || { echo "::error::missing image digest"; exit 1; }
          overlay="clusters/apps/${APP}/overlays/staging"
          for attempt in 1 2 3 4 5; do
            git fetch -q origin main && git reset -q --hard origin/main
            ( cd "$overlay" && kustomize edit set image \
                "${IMAGE}=${IMAGE}@${DIGEST}" )
            if git diff --quiet; then
              echo "overlay already at ${DIGEST} — nothing to deploy"; exit 0
            fi
            git commit -qam "deploy(${APP}): staging -> ${DIGEST}"
            if git push; then exit 0; fi
            echo "push rejected (attempt $attempt) — re-syncing main and retrying"; sleep $((attempt * 3))
          done
          echo "::error::could not push digest-bump after 5 attempts"; exit 1
