terraform {
  required_version = ">= 1.6.0"

  required_providers {
[% if cloud == "hetzner" %]
    hcloud = {
      source  = "hetznercloud/hcloud"
      version = "~> 1.48"
    }
[% elif cloud == "digitalocean" %]
    digitalocean = {
      source  = "digitalocean/digitalocean"
      version = "~> 2.43"
    }
[% endif %]
  }
}

[% if cloud == "hetzner" %]
provider "hcloud" {
  token = var.hcloud_token
}
[% elif cloud == "digitalocean" %]
provider "digitalocean" {
  token = var.do_token
}
[% endif %]
