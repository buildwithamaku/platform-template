[% if cloud == "hetzner" %]
module "cluster" {
  source = "../../modules/cluster-k3s"

  # Token reaches the module so the init node can plant the `hcloud` Secret that
  # hcloud-cloud-controller-manager uses (it fulfils the ingress LoadBalancer).
  hcloud_token = var.hcloud_token

  cluster_name = "[< client_name >]-prod"
  location     = "[< region >]"

  # Prod is HA: 3 servers with embedded-etcd quorum (D-02). Use the AMD CPX line
  # (cpx32 = 4 vCPU / 8 GB); run scripts/hetzner-server-types.sh <region> first.
  server_count = 3
  server_type  = "[< prod_node_type >]"

  ssh_public_keys   = var.ssh_public_keys
  api_allowed_cidrs = var.api_allowed_cidrs

  labels = {
    environment = "prod"
    part_of     = "[< client_name >]"
  }
}
[% elif cloud == "digitalocean" %]
module "cluster" {
  source = "../../modules/cluster-doks"

  do_token           = var.do_token
  cluster_name       = "[< client_name >]-prod"
  region             = "[< region >]"
  k8s_version_prefix = "[< k8s_version >]"

  # Prod: HA control plane + [< prod_node_count >] nodes.
  node_size        = "[< prod_node_type >]"
  node_count       = [< prod_node_count >]
  ha_control_plane = true
[% if gpu %]  gpu_node_size    = "[< gpu_node_size >]"
[% endif %]
  labels = {
    environment = "prod"
    part_of     = "[< client_name >]"
  }
}
[% elif cloud == "baremetal" %]
module "cluster" {
  source = "../../modules/cluster-k3s-byo"

  cluster_name = "[< client_name >]-prod"

  # You provision the nodes (InterServer/OVH/…); tofu installs k3s over SSH.
  # Supply the IPs + key path in terraform.tfvars (see terraform.tfvars.example).
  control_plane_ip     = var.control_plane_ip
  agent_ips            = var.agent_ips
  ssh_user             = var.ssh_user
  ssh_private_key_path = var.ssh_private_key_path
  api_tls_sans         = var.api_tls_sans

  labels = {
    environment = "prod"
    part_of     = "[< client_name >]"
  }
}
[% endif %]

# Write the kubeconfig next to the root so the acceptance test is a one-liner:
#   export KUBECONFIG=$PWD/kubeconfig && kubectl get nodes
resource "local_sensitive_file" "kubeconfig" {
  content         = module.cluster.kubeconfig
  filename        = "${path.module}/kubeconfig"
  file_permission = "0600"
}
