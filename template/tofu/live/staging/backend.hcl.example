# Copy to backend.hcl (git-ignored) and fill in. Then:
#   tofu init -backend-config=backend.hcl
#
# Hetzner Object Storage example (bucket must exist first):
bucket    = "amakusolutions-tofu-state"
endpoints = { s3 = "https://fsn1.your-objectstorage.com" }

# Credentials come from the environment, NOT this file:
#   export AWS_ACCESS_KEY_ID=...      # Hetzner Object Storage access key
#   export AWS_SECRET_ACCESS_KEY=...  # Hetzner Object Storage secret key
