# cap_db_app_role — password for the CNPG-managed `[< db_app_role_name >]` runtime role. ESO builds
# a basic-auth Secret from Infisical; CNPG's managed.roles reads it to set the role's
# password (see cluster.yaml). The Secret's `username` MUST equal the role name
# (`[< db_app_role_name >]`) — CNPG validates that.
#
# Infisical (client path): APP_DB_RW_PASSWORD = a strong random string. Keep it
# URL-safe (e.g. `openssl rand -hex 24`) — the app-rw connection Secret embeds it
# verbatim in a postgresql:// URI, so `/`, `@`, `:` would corrupt the URL.
#
# COUPLING (runbook): if this key is MISSING from Infisical, this Secret never syncs,
# CNPG can't reconcile the [< db_app_role_name >] managed role, the app-rw-grants Job exhausts its
# backoffLimit, and the app runs with NO working runtime DB role. Provision this key
# before enabling cap_db_app_role.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: app-rw-credentials
  namespace: data
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: infisical
    kind: ClusterSecretStore
  target:
    name: app-rw-credentials
    template:
      type: kubernetes.io/basic-auth
      data:
        username: [< db_app_role_name >]
        password: "{{ .password }}"
  data:
    - secretKey: password
      remoteRef:
        key: APP_DB_RW_PASSWORD
