# Reference Postgres Cluster (D-05): 3 instances = 1 primary + 2 replicas with
# automatic failover. CNPG generates the `[< client_name >]-db-app` Secret (username,
# password, dbname, and a ready-made connection `uri`) — that is the app's
# DATABASE_URL, so the source is swappable (RDS on AWS) without app changes.
#
# WAL archiving + backups go to Cloudflare R2 (S3-compatible, zero egress). The
# R2 credentials arrive as the `r2-credentials` Secret via ESO (see backup.yaml);
# the ScheduledBackup that drives base backups also lives there.
#
# NOTE: barmanObjectStore is the in-tree backup API — deprecated and REMOVED in
# CloudNativePG 1.31.0. The operator is pinned to 1.30 (chart 0.29.0), so this is
# safe as-is. REQUIRED FOLLOW-UP before bumping the operator to 1.31: migrate to
# the Barman Cloud plugin (it needs cert-manager, which we already run). In-tree
# is used now for simplicity while proving the PITR flow.
apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: [< client_name >]-db
  namespace: data
spec:
  instances: 3
  primaryUpdateStrategy: unsupervised

  storage:
    size: 2Gi

  # Spread instances across nodes; tolerate a single node loss.
  affinity:
    podAntiAffinityType: preferred

  bootstrap:
    initdb:
      database: appdb
      owner: appuser
[% if cap_vector_db %]
      # cap_vector_db: enable pgvector in appdb. postInitApplicationSQL runs once,
      # at initdb, as the bootstrap SUPERUSER inside the application database — the
      # only in-spec place `CREATE EXTENSION vector` can run, since pgvector is an
      # UNtrusted extension (needs superuser) and CNPG leaves superuser access off.
      # Requires a pgvector-capable image: CNPG's default (standard-flavor) images
      # bundle pgvector, so no imageName override is needed here. If you pin a
      # `minimal` image, add pgvector or this step fails. Runs only on a FRESH
      # cluster — to add pgvector to an already-bootstrapped DB, run
      # `CREATE EXTENSION IF NOT EXISTS vector` once as a superuser by hand.
      postInitApplicationSQL:
        - CREATE EXTENSION IF NOT EXISTS vector
[% endif %]

  # Surface Postgres metrics for Phase 5 (kube-prometheus-stack scrapes this).
  monitoring:
    enablePodMonitor: false

  # WAL archiving + base backups to Cloudflare R2. Enabling this turns on
  # continuous WAL archiving, which (with a base backup) is what makes PITR work.
  backup:
    retentionPolicy: 7d
    barmanObjectStore:
      # Bucket root only — CNPG nests under the serverName (= cluster name), so
      # data lands at s3://[< client_name >]-pg-backups/[< client_name >]-db/{base,wals}. Do NOT
      # add the cluster name here or it double-nests ([< client_name >]-db/[< client_name >]-db).
      destinationPath: s3://[< client_name >]-pg-backups
      endpointURL: https://[< r2_account_id >].r2.cloudflarestorage.com
      s3Credentials:
        accessKeyId:
          name: r2-credentials
          key: ACCESS_KEY_ID
        secretAccessKey:
          name: r2-credentials
          key: SECRET_ACCESS_KEY
      wal:
        compression: gzip
      data:
        compression: gzip

  # Managed read-only role for Metabase BI (Phase 7). CNPG creates/maintains the
  # role declaratively; its password comes from the metabase-ro-credentials Secret
  # (ESO -> Infisical). Object-level GRANTs on appdb are applied by the
  # metabase-ro-grants hook Job — CNPG manages the ROLE, not object privileges.
  managed:
    roles:
      - name: metabase_ro
        ensure: present
        comment: Read-only BI access for Metabase (Phase 7)
        login: true
        superuser: false
        createdb: false
        createrole: false
        inherit: true
        passwordSecret:
          name: metabase-ro-credentials
[% if cap_db_app_role %]
      # cap_db_app_role: the least-privilege RUNTIME role. Non-owner + non-super,
      # so it does NOT bypass row-level security (CNPG creates roles NOBYPASSRLS) —
      # RLS policies declared in the app's migrations are enforced against it.
      # CNPG manages the role + password; read-write object GRANTs are applied by
      # the app-rw-grants hook Job. Schema DDL stays with the owner (migration Job).
      - name: [< db_app_role_name >]
        ensure: present
        comment: Least-privilege read-write runtime role (RLS-subject; non-owner)
        login: true
        superuser: false
        createdb: false
        createrole: false
        inherit: true
        passwordSecret:
          name: app-rw-credentials
[% endif %]
