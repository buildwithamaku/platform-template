apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: backend-config
  namespace: data
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: infisical
    kind: ClusterSecretStore
  target:
    name: backend-config
  data:
[% for name, key in service_config.get("backend", {}).get("secrets", {}).items() %]
    - secretKey: [< name | tojson >]
      remoteRef:
        key: [< key | tojson >]
[% endfor %]
