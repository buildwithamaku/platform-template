# Object-level GRANTs for the read-only Metabase role (Phase 7 acceptance:
# "Metabase queries prod data read-only; a write attempt fails").
#
# CNPG's managed.roles creates the ROLE but not privileges on database objects,
# so this hook Job connects as `appuser` (the appdb owner, via the CNPG-generated
# [< client_name >]-db-app secret) and grants SELECT-only. ALTER DEFAULT PRIVILEGES makes
# future tables readable too, so new migrations don't silently break BI. There is
# deliberately no INSERT/UPDATE/DELETE/CREATE grant — the role can only read.
#
# PostSync + idempotent + waits for the role to exist, so it is safe to re-run on
# every sync and tolerant of CNPG reconciling the role slightly after the Cluster.
apiVersion: batch/v1
kind: Job
metadata:
  name: metabase-ro-grants
  namespace: data
  annotations:
    argocd.argoproj.io/hook: PostSync
    argocd.argoproj.io/hook-delete-policy: BeforeHookCreation
spec:
  backoffLimit: 5
  activeDeadlineSeconds: 300
  template:
    metadata:
      labels:
        app.kubernetes.io/name: metabase-ro-grants
    spec:
      restartPolicy: Never
      securityContext:
        runAsNonRoot: true
        runAsUser: 26 # postgres uid in the CNPG image
      containers:
        - name: grants
          # Must match the running CNPG cluster image (has psql, already pulled on
          # the node). Keep in sync with the operator's default PG image; a copier
          # variable in Phase 8. A wrong/absent tag here stalls the Job to its
          # activeDeadline instead of failing fast.
          image: ghcr.io/cloudnative-pg/postgresql:18.4-system-trixie
          command: ["/bin/sh", "-c"]
          args:
            - |
              set -eu
              echo "waiting for the metabase_ro role to exist..."
              until psql "$DATABASE_URL" -tAc \
                "SELECT 1 FROM pg_roles WHERE rolname = 'metabase_ro'" | grep -q 1; do
                sleep 5
              done
              echo "granting read-only privileges on appdb to metabase_ro"
              psql "$DATABASE_URL" -v ON_ERROR_STOP=1 <<'SQL'
              GRANT CONNECT ON DATABASE appdb TO metabase_ro;
              GRANT USAGE ON SCHEMA public TO metabase_ro;
              GRANT SELECT ON ALL TABLES IN SCHEMA public TO metabase_ro;
              GRANT SELECT ON ALL SEQUENCES IN SCHEMA public TO metabase_ro;
              ALTER DEFAULT PRIVILEGES FOR ROLE appuser IN SCHEMA public
                GRANT SELECT ON TABLES TO metabase_ro;
              -- belt-and-suspenders: ensure the role cannot create objects
              REVOKE CREATE ON SCHEMA public FROM metabase_ro;
              SQL
              echo "done."
          env:
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: [< client_name >]-db-app # appuser / owner of appdb
                  key: uri
          resources:
            requests: { cpu: 25m, memory: 48Mi }
            limits: { memory: 128Mi }
