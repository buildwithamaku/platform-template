# cap_db_app_role — the runtime connection Secret the app consumes as the [< db_app_role_name >]
# (non-owner) role. Mirrors the shape of CNPG's generated `[< client_name >]-db-app` Secret
# (owner) so apps switch source by name only: a `uri` for single-URL apps (the
# reference backend's DATABASE_URL) AND discrete host/port/dbname/username/password
# for apps that take separate DB_* vars (e.g. a NestJS app with DB_MIGRATIONS_RUN=false).
#
# Host is the CNPG read-write Service `[< client_name >]-db-rw` in this same `data` namespace
# (apps run in `data`), so the short name resolves. Password comes from the same
# Infisical key as the managed role, so the connection Secret and the role never drift.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: [< client_name >]-db-app-rw
  namespace: data
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: infisical
    kind: ClusterSecretStore
  target:
    name: [< client_name >]-db-app-rw
    template:
      engineVersion: v2
      data:
        username: [< db_app_role_name >]
        password: "{{ .password }}"
        host: [< client_name >]-db-rw
        port: "5432"
        dbname: appdb
        uri: "postgresql://[< db_app_role_name >]:{{ .password }}@[< client_name >]-db-rw:5432/appdb"
  data:
    - secretKey: password
      remoteRef:
        key: APP_DB_RW_PASSWORD
