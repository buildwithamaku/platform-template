# Delivers the Cloudflare API token from Infisical (/{{ client_name }}/CLOUDFLARE_API_TOKEN,
# staging env) into the two namespaces that need it: cert-manager (DNS-01 solver)
# and ingress (external-dns). One ExternalSecret per namespace — secrets are
# namespaced. Add CLOUDFLARE_API_TOKEN in Infisical (Zone.DNS:Edit + Zone:Read).
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: cloudflare-api-token
  namespace: cert-manager
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: infisical
    kind: ClusterSecretStore
  target:
    name: cloudflare-api-token
    creationPolicy: Owner
  data:
    - secretKey: apiToken
      remoteRef:
        key: CLOUDFLARE_API_TOKEN
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: cloudflare-api-token
  namespace: ingress
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: infisical
    kind: ClusterSecretStore
  target:
    name: cloudflare-api-token
    creationPolicy: Owner
  data:
    - secretKey: apiToken
      remoteRef:
        key: CLOUDFLARE_API_TOKEN
