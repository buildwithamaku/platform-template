# Cluster-wide gateway from Infisical Cloud -> Kubernetes Secrets (D-04, §5.3).
# Authenticates with the single machine-identity credential planted by
# bootstrap.sh (Secret infisical-universal-auth in the external-secrets ns).
# Every ExternalSecret in the cluster references this store by name.
#
# PER CLIENT: set spec.provider.infisical.secretsScope.projectSlug below to the
# client's Infisical project slug (Project Settings -> copy the slug). The slug
# is not a secret, so it is committed here; the client ID/secret are NOT.
# (Currently wired to the reference client: {{ platform_repo }}-t-ah-6.)
apiVersion: external-secrets.io/v1
kind: ClusterSecretStore
metadata:
  name: infisical
spec:
  provider:
    infisical:
      hostAPI: https://app.infisical.com/api
      auth:
        universalAuthCredentials:
          clientId:
            name: infisical-universal-auth
            key: clientId
            namespace: external-secrets
          clientSecret:
            name: infisical-universal-auth
            key: clientSecret
            namespace: external-secrets
      # env separation is via the Infisical ENVIRONMENT (staging/prod), so the
      # path is just the client root; per-app secrets live at /{{ client_name }}/<app>/.
      # (§5.3's "/<client>/<env>/<app>/KEY" maps <env> -> environmentSlug here.)
      secretsScope:
        projectSlug: {{ platform_repo }}-t-ah-6
        environmentSlug: staging
        secretsPath: /{{ client_name }}
        recursive: true
