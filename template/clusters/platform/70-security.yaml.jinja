# Wave 7: cluster security policies, applied after the workload namespaces exist
# (demo w5, cache/data w6). Git-sourced (pins main — see clusters/README.md).
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: security
  namespace: argocd
  annotations:
    argocd.argoproj.io/sync-wave: "7"
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: default
  source:
    repoURL: https://github.com/[< registry_org >]/[< platform_repo >].git
    targetRevision: main
    path: clusters/platform-config/security
  destination:
    server: https://kubernetes.default.svc
    namespace: default
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
