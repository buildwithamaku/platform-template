# Wave 1: deploy the Infisical ClusterSecretStore AFTER ESO's CRDs exist.
# NOTE: git-sourced Application manifests cannot be templated by bootstrap.sh
# (ArgoCD reads them verbatim), so repoURL/targetRevision are literal here.
# For local pre-merge testing against a branch, see clusters/README.md.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: infisical-store
  namespace: argocd
  annotations:
    argocd.argoproj.io/sync-wave: "1"
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: default
  source:
    repoURL: https://github.com/{{ registry_org }}/{{ platform_repo }}.git
    targetRevision: main
    path: clusters/platform-config/infisical
  destination:
    server: https://kubernetes.default.svc
    namespace: external-secrets
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
