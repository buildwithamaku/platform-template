# Wave 11: the reference backend (Kustomize overlay). Points at overlays/staging
# — on a real prod cluster the equivalent Application points at overlays/prod.
# Needs the CNPG Cluster (wave 6, app secret) and the OTel Collector (wave 9).
# Git-sourced (pins main).
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: backend
  namespace: argocd
  annotations:
    argocd.argoproj.io/sync-wave: "11"
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: default
  source:
    repoURL: https://github.com/[< registry_org >]/[< platform_repo >].git
    targetRevision: main
    path: clusters/apps/backend/overlays/staging
  destination:
    server: https://kubernetes.default.svc
    namespace: data
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
