# Wave 2: the Phase-2 acceptance target — a dummy Deployment fed by an
# ExternalSecret, restarted by Reloader on secret change. Delete this Application
# once real apps (Phase 6) exist; it proves the secret-rotation loop end to end.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: demo
  namespace: argocd
  annotations:
    # Wave 5: after ingress-nginx (3) and the edge-config issuers (4), so the
    # demo Ingress's Certificate finds its ClusterIssuer + IngressClass on first
    # sync instead of backing off.
    argocd.argoproj.io/sync-wave: "5"
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: default
  source:
    repoURL: https://github.com/{{ registry_org }}/{{ platform_repo }}.git
    targetRevision: main
    path: clusters/apps/demo
  destination:
    server: https://kubernetes.default.svc
    namespace: demo
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
