# prod_profile — Valkey requirepass credential. Without this the cache has NO auth
# and anything on the tailnet can read/write it (see redisinsight.yaml note). ESO
# builds a Secret from Infisical; the StatefulSet reads it for --requirepass and its
# probes (REDISCLI_AUTH).
#
# Infisical (client path): VALKEY_PASSWORD = a strong random string (openssl rand -hex 24).
#
# COUPLING: if this key is missing, the Secret never syncs and the valkey pod can't
# start (its --requirepass env is unresolved). Provision it before enabling prod_profile.
#
# Clients that use the cache (if any) must authenticate once this is on — pass the
# same VALKEY_PASSWORD in their connection URL/config, or they get NOAUTH.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: valkey-auth
  namespace: cache
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: infisical
    kind: ClusterSecretStore
  target:
    name: valkey-auth
  data:
    - secretKey: password
      remoteRef:
        key: VALKEY_PASSWORD
