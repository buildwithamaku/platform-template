# Valkey (D-05 cache) — the BSD-licensed Redis fork. Plain StatefulSet on the
# official image (no Bitnami). Single instance with AOF persistence: enough for
# staging. Prod HA (Valkey Sentinel/cluster) is still a follow-up; it is always
# ClusterIP-only (never publicly exposed).
[% if prod_profile %]# prod_profile: AUTH is on — --requirepass from the valkey-auth Secret (ESO).[% else %]# AUTH is OFF (tailnet is the boundary); enable it with prod_profile.[% endif %]
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: valkey
  namespace: cache
  labels:
    app.kubernetes.io/name: valkey
    app.kubernetes.io/part-of: [< client_name >]
[% if prod_profile %]
  annotations:
    reloader.stakater.com/auto: "true" # roll the pod when VALKEY_PASSWORD rotates
[% endif %]
spec:
  serviceName: valkey
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: valkey
  template:
    metadata:
      labels:
        app.kubernetes.io/name: valkey
        app.kubernetes.io/part-of: [< client_name >]
    spec:
      securityContext:
        runAsNonRoot: true
        runAsUser: 999
        fsGroup: 999
      containers:
        - name: valkey
          image: valkey/valkey:8-alpine
          args:
            - "--appendonly"
            - "yes"
            - "--dir"
            - "/data"
[% if prod_profile %]
            - "--requirepass"
            - "$(VALKEY_PASSWORD)" # k8s expands $(ENV) from the env below at start
[% endif %]
[% if prod_profile %]
          env:
            - name: VALKEY_PASSWORD
              valueFrom: { secretKeyRef: { name: valkey-auth, key: password } }
            - name: REDISCLI_AUTH # so the `valkey-cli ping` probes authenticate
              valueFrom: { secretKeyRef: { name: valkey-auth, key: password } }
[% endif %]
          ports:
            - { containerPort: 6379, name: valkey }
          volumeMounts:
            - { name: data, mountPath: /data }
          readinessProbe:
            exec: { command: ["valkey-cli", "ping"] }
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            exec: { command: ["valkey-cli", "ping"] }
            initialDelaySeconds: 10
            periodSeconds: 15
          resources:
            requests: { cpu: 25m, memory: 32Mi }
            limits: { cpu: 250m, memory: 256Mi }
  volumeClaimTemplates:
    - metadata:
        name: data
      spec:
        accessModes: ["ReadWriteOnce"]
        resources:
          requests:
            storage: 1Gi
