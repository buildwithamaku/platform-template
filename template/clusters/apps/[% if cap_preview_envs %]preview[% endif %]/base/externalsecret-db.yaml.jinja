# Per-PR DATABASE_URL. Creates the [< client_name >]-db-app secret (the same name +
# `uri` key the backend expects, §5.4 contract) in the preview namespace, filled
# from a SHARED preview DB connection string in Infisical. So previews reuse the
# app's Deployment unchanged — only the source of the URL differs.
#
# Infisical key (client path): PREVIEW_DATABASE_URL = a postgres:// URI to a
# shared preview/staging database. TRADE-OFF: all previews share it (fine for
# read-mostly PR review; risky for PRs that migrate schema). For isolation, give
# each PR its own CNPG Cluster instead — see the RUNBOOK preview-envs entry.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: [< client_name >]-db-app
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: infisical
    kind: ClusterSecretStore
  target:
    name: [< client_name >]-db-app
  data:
    - secretKey: uri
      remoteRef:
        key: PREVIEW_DATABASE_URL
