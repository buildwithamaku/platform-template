# Prod PostSync smoke check (§6.2 / Phase-7 acceptance: "failure alerts + revert").
# After ArgoCD syncs prod, this runs the @smoke pack against the backend Service.
#
# IMPORTANT — this DETECTS a bad deploy, it does not PREVENT one. PostSync runs
# only after the Sync phase is applied and Healthy, so by now the new version is
# already live and the old ReplicaSet is scaled to zero. A smoke failure marks the
# sync Failed (red in Argo) and trips BackendPostDeploySmokeFailed -> Slack (page),
# so a human `git revert`s the bad tag. It is fast automated detection + a page,
# not a rollout gate. (True gating = new version held back until smoke passes would
# need progressive delivery — Argo Rollouts + AnalysisTemplate — which the plan
# does not ask for.) Note: contract breaks that also fail /readyz never reach here
# (the rolling update stalls first — that's the readiness probe, not this).
#
# Same e2e image as staging; args select the @smoke subset. Runs in `data` (uses
# ghcr-pull — the [< client_name >]-e2e package must be authorized for that pull token).
apiVersion: batch/v1
kind: Job
metadata:
  name: backend-smoke
  namespace: data
  labels:
    app.kubernetes.io/name: backend-smoke
  annotations:
    argocd.argoproj.io/hook: PostSync
    argocd.argoproj.io/hook-delete-policy: BeforeHookCreation
spec:
  backoffLimit: 1
  activeDeadlineSeconds: 300
  template:
    metadata:
      labels:
        app.kubernetes.io/name: backend-smoke
    spec:
      restartPolicy: Never
      imagePullSecrets:
        - name: ghcr-pull
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000 # node user in node:[< node_version >]-slim
      containers:
        - name: smoke
          image: ghcr.io/[< registry_org >]/[< client_name >]-e2e
          args: ["--grep", "@smoke"]
          env:
            - { name: BASE_URL, value: "http://backend.data.svc" }
            - { name: CI, value: "true" }
          resources:
            requests: { cpu: 50m, memory: 128Mi }
            limits: { memory: 256Mi }
