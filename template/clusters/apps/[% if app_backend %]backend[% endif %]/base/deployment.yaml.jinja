[% set config = service_config.get("backend", {}) %]
# Reference backend Deployment. Consumes DATABASE_URL — the §5.4 contract,
# source-swappable. The reloader annotation rolls it when that secret rotates.
# Image TAG is set by the overlay (bumped by CI); base leaves it bare.
[% if cap_db_app_role %]#
# cap_db_app_role ON: runtime connects as the least-privilege NON-OWNER role via
# [< client_name >]-db-app-rw ([< db_app_role_name >] — no DDL, RLS-subject). Schema migrations still run
# as the OWNER through the PreSync migration Job ([< client_name >]-db-app), so DDL and
# runtime are cleanly separated.
[% else %]#
# Consumes [< client_name >]-db-app.uri (the CNPG-generated owner secret).
[% endif %]
apiVersion: apps/v1
kind: Deployment
metadata:
  name: backend
  labels:
    app.kubernetes.io/name: backend
    app.kubernetes.io/part-of: [< client_name >]
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  replicas: 2
  selector:
    matchLabels:
      app.kubernetes.io/name: backend
  template:
    metadata:
      labels:
        app.kubernetes.io/name: backend
        app.kubernetes.io/part-of: [< client_name >]
    spec:
      imagePullSecrets:
        - name: ghcr-pull
      securityContext:
        runAsNonRoot: true # numeric UID comes from the image or explicit run_as_user configuration
[% if config.get("run_as_user") %]
        runAsUser: [< config.run_as_user >]
[% endif %]
      containers:
        - name: backend
          image: ghcr.io/[< registry_org >]/[< client_name >]-backend
          ports:
            - { containerPort: [< config.get("port", 8080) >], name: http }
          env:
            - name: PORT
              value: [< config.get("port", 8080) | string | tojson >]
[% if cap_single_writer %]
            - name: SCHEDULER_ENABLED # web pods NEVER run the scheduler — the
              value: "false"          # single worker Deployment does (cap_single_writer)
[% endif %]
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: [% if cap_db_app_role %][< client_name >]-db-app-rw[% else %][< client_name >]-db-app[% endif %]
                  key: uri
            - name: OTEL_EXPORTER_OTLP_ENDPOINT
              value: http://otel-collector-opentelemetry-collector.monitoring:4318
[% for name, value in config.get("env", {}).items() %]
            - name: [< name | tojson >]
              value: [< value | tojson >]
[% endfor %]
[% for name, key in config.get("db_env", {}).items() %]
            - name: [< name | tojson >]
              valueFrom:
                secretKeyRef:
                  name: [% if cap_db_app_role %][< client_name >]-db-app-rw[% else %][< client_name >]-db-app[% endif %]
                  key: [< key | tojson >]
[% endfor %]
[% if config.get("secrets") %]
          envFrom:
            - secretRef:
                name: backend-config
[% endif %]
          readinessProbe:
            httpGet: { path: [< config.get("ready_path", backend_ready_path) | tojson >], port: http }
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet: { path: [< config.get("health_path", backend_health_path) | tojson >], port: http }
            initialDelaySeconds: 5
            periodSeconds: 15
          resources:
            requests: { cpu: 25m, memory: 48Mi }
            limits: { memory: 128Mi }
