[% set migration = service_config.get("backend", {}).get("migration", {}) %]
# PreSync migration hook (§5.4 / §6.2): ArgoCD runs `app migrate` BEFORE rolling
# the Deployment. If it fails, the sync fails and the Deployment is never updated
# — the old version keeps serving. Same image/tag as the Deployment (Kustomize
# sets the tag on both), so migrations always match the code being deployed.
apiVersion: batch/v1
kind: Job
metadata:
  name: backend-migrate
  labels:
    app.kubernetes.io/name: backend
  annotations:
    argocd.argoproj.io/hook: PreSync
    argocd.argoproj.io/hook-delete-policy: BeforeHookCreation
spec:
  backoffLimit: 1
  activeDeadlineSeconds: 300
  template:
    metadata:
      labels:
        app.kubernetes.io/name: backend
    spec:
      restartPolicy: Never
      imagePullSecrets:
        - name: ghcr-pull
      securityContext:
        runAsNonRoot: true # numeric UID comes from the image or explicit run_as_user configuration
[% if service_config.get("backend", {}).get("run_as_user") %]
        runAsUser: [< service_config.backend.run_as_user >]
[% endif %]
      containers:
        - name: migrate
          image: ghcr.io/[< registry_org >]/[< client_name >]-backend
[% if migration.get("command") %]
          command: [< migration.command | tojson >]
[% endif %]
          args: [< migration.get("args", ["migrate"]) | tojson >]
          env:
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: [< client_name >]-db-app
                  key: uri
[% for name, value in migration.get("env", {}).items() %]
            - name: [< name | tojson >]
              value: [< value | tojson >]
[% endfor %]
[% for name, key in migration.get("db_env", {}).items() %]
            - name: [< name | tojson >]
              valueFrom:
                secretKeyRef:
                  name: [< client_name >]-db-app
                  key: [< key | tojson >]
[% endfor %]
[% if migration.get("secrets") %]
          envFrom:
            - secretRef:
                name: backend-migration-config
[% endif %]
          resources:
            requests: { cpu: 25m, memory: 48Mi }
            limits: { memory: 128Mi }
