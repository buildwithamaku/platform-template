# Reference backend Deployment. Consumes DATABASE_URL — the §5.4 contract,
# source-swappable. The reloader annotation rolls it when that secret rotates.
# Image TAG is set by the overlay (bumped by CI); base leaves it bare.
[% if cap_db_app_role %]#
# cap_db_app_role ON: runtime connects as the least-privilege NON-OWNER role via
# [< client_name >]-db-app-rw ([< db_app_role_name >] — no DDL, RLS-subject). Schema migrations still run
# as the OWNER through the PreSync migration Job ([< client_name >]-db-app), so DDL and
# runtime are cleanly separated.
[% else %]#
# Consumes [< client_name >]-db-app.uri (the CNPG-generated owner secret).
[% endif %]
apiVersion: apps/v1
kind: Deployment
metadata:
  name: backend
  labels:
    app.kubernetes.io/name: backend
    app.kubernetes.io/part-of: [< client_name >]
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  replicas: 2
  selector:
    matchLabels:
      app.kubernetes.io/name: backend
  template:
    metadata:
      labels:
        app.kubernetes.io/name: backend
        app.kubernetes.io/part-of: [< client_name >]
    spec:
      imagePullSecrets:
        - name: ghcr-pull
      securityContext:
        runAsNonRoot: true # the app image MUST declare a NUMERIC non-root USER (APP-CONTRACT);
        # the factory does not pin a uid — the image's USER wins (distroless=65532, node-slim=1000, ...).
      containers:
        - name: backend
          image: ghcr.io/[< registry_org >]/[< client_name >]-backend
          ports:
            - { containerPort: 8080, name: http }
          env:
            - name: PORT
              value: "8080"
[% if cap_single_writer %]
            - name: SCHEDULER_ENABLED # web pods NEVER run the scheduler — the
              value: "false"          # single worker Deployment does (cap_single_writer)
[% endif %]
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: [% if cap_db_app_role %][< client_name >]-db-app-rw[% else %][< client_name >]-db-app[% endif %]
                  key: uri
            - name: OTEL_EXPORTER_OTLP_ENDPOINT
              value: http://otel-collector-opentelemetry-collector.monitoring:4318
          readinessProbe:
            httpGet: { path: [< backend_ready_path >], port: http }
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet: { path: [< backend_health_path >], port: http }
            initialDelaySeconds: 5
            periodSeconds: 15
          resources:
            requests: { cpu: 25m, memory: 48Mi }
            limits: { memory: 128Mi }
