# Reference backend Deployment. Consumes DATABASE_URL from the CNPG-generated
# app secret ([< client_name >]-db-app.uri) — the §5.4 contract, source-swappable. The
# reloader annotation rolls it when that secret rotates. Image TAG is set by the
# overlay (bumped by CI); base leaves it bare.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: backend
  labels:
    app.kubernetes.io/name: backend
    app.kubernetes.io/part-of: [< client_name >]
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  replicas: 2
  selector:
    matchLabels:
      app.kubernetes.io/name: backend
  template:
    metadata:
      labels:
        app.kubernetes.io/name: backend
        app.kubernetes.io/part-of: [< client_name >]
    spec:
      imagePullSecrets:
        - name: ghcr-pull
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532 # distroless:nonroot uid — kubelet needs a numeric uid to verify non-root
      containers:
        - name: backend
          image: ghcr.io/[< registry_org >]/[< client_name >]-backend
          ports:
            - { containerPort: 8080, name: http }
          env:
            - name: PORT
              value: "8080"
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: [< client_name >]-db-app
                  key: uri
            - name: OTEL_EXPORTER_OTLP_ENDPOINT
              value: http://otel-collector-opentelemetry-collector.monitoring:4318
          readinessProbe:
            httpGet: { path: /readyz, port: http }
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet: { path: /healthz, port: http }
            initialDelaySeconds: 5
            periodSeconds: 15
          resources:
            requests: { cpu: 25m, memory: 48Mi }
            limits: { memory: 128Mi }
