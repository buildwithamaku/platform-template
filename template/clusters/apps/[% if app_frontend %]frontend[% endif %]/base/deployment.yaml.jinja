# Reference frontend Deployment (app_frontend). Serving mode = frontend_type:
#   static — built assets behind unprivileged nginx (Vite/CRA/Angular/Vue, or
#            Next `output: export`). No Node runtime; nginx listens on :8080.
#   ssr    — a Node server ($PORT) for SSR (Next `output: standalone`, Nuxt, Remix).
# Image TAG is set by the overlay (bumped by CI); base leaves it bare.
#
# The container port is named `http` in BOTH modes, so Service + Ingress are
# mode-agnostic (only this container spec differs).
apiVersion: apps/v1
kind: Deployment
metadata:
  name: frontend
  labels:
    app.kubernetes.io/name: frontend
    app.kubernetes.io/part-of: [< client_name >]
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  replicas: 2
  selector:
    matchLabels:
      app.kubernetes.io/name: frontend
  template:
    metadata:
      labels:
        app.kubernetes.io/name: frontend
        app.kubernetes.io/part-of: [< client_name >]
    spec:
      imagePullSecrets:
        - name: ghcr-pull
[% if frontend_type == 'ssr' %]
      # ── ssr: Node server ──────────────────────────────────────────────────
      # BUILD CONTRACT: listens on $PORT (3000) and binds 0.0.0.0 (Next standalone
      # only binds all interfaces when HOSTNAME=0.0.0.0); GET / returns < 400.
      # PUBLIC-VAR CAVEAT: framework NEXT_PUBLIC_* / VITE_* are inlined into the
      # client bundle at BUILD time — the runtime env below only reaches SSR code.
      securityContext:
        runAsNonRoot: true # numeric non-root USER in the image (APP-CONTRACT); factory pins no uid
      containers:
        - name: frontend
          image: ghcr.io/[< registry_org >]/[< client_name >]-frontend
          ports:
            - { containerPort: 3000, name: http }
          env:
            - name: PORT
              value: "3000"
            - name: HOSTNAME # Next standalone binds 0.0.0.0 only when this is set
              value: "0.0.0.0"
            - name: NODE_ENV
              value: production
            - name: NEXT_PUBLIC_API_URL # server-side only (browser uses the build-time value)
              value: https://api.[< domain >]
          readinessProbe:
            httpGet: { path: /, port: http }
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            tcpSocket: { port: http }
            initialDelaySeconds: 10
            periodSeconds: 15
          resources:
            requests: { cpu: 25m, memory: 96Mi }
            limits: { memory: 256Mi }
[% else %]
      # ── static: unprivileged nginx serving built assets ───────────────────
      # BUILD CONTRACT: image serves the built SPA on :8080 as a non-root user.
      # Base your Dockerfile on `nginxinc/nginx-unprivileged` (listens 8080, uid
      # 101) and COPY the build output into /usr/share/nginx/html. Any public API
      # URL (VITE_API_URL / NEXT_PUBLIC_API_URL) is baked at build; the browser
      # calls the backend's public ingress (api.[< domain >]) directly.
      #
      # SPA FALLBACK (do not skip for client-side routing): also COPY an nginx
      # config with `location / { try_files $uri $uri/ /index.html; }`, or deep
      # links (/dashboard, a refresh, a shared URL) 404. The probes below hit / —
      # which always returns index.html — so a missing fallback passes health
      # checks and fails ONLY for the user at deep-link time. (Pure static sites
      # with real files per route don't need this.)
      securityContext:
        runAsNonRoot: true # numeric non-root USER in the image (APP-CONTRACT); factory pins no uid
      containers:
        - name: frontend
          image: ghcr.io/[< registry_org >]/[< client_name >]-frontend
          ports:
            - { containerPort: 8080, name: http }
          readinessProbe:
            httpGet: { path: /, port: http }
            initialDelaySeconds: 3
            periodSeconds: 10
          livenessProbe:
            httpGet: { path: /, port: http }
            initialDelaySeconds: 5
            periodSeconds: 15
          resources:
            requests: { cpu: 10m, memory: 32Mi }
            limits: { memory: 128Mi }
[% endif %]
