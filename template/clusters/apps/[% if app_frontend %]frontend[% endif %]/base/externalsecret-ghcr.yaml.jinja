# Image-pull credential for the frontend namespace — mirrors the data-ns
# ghcr-pull ExternalSecret so this ns can pull the private frontend image.
# Infisical keys (client path): GHCR_USERNAME, GHCR_PULL_TOKEN.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: ghcr-pull
  namespace: frontend
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: infisical
    kind: ClusterSecretStore
  target:
    name: ghcr-pull
    template:
      type: kubernetes.io/dockerconfigjson
      data:
        .dockerconfigjson: |
          {"auths":{"ghcr.io":{"username":"{{ .username }}","password":"{{ .token }}","auth":"{{ printf "%s:%s" .username .token | b64enc }}"}}}
  data:
    - secretKey: username
      remoteRef:
        key: GHCR_USERNAME
    - secretKey: token
      remoteRef:
        key: GHCR_PULL_TOKEN
