# Prod overlay — deployed to the prod cluster. The image newTag is bumped only
# via an approved PROMOTION PR (§6.2), never automatically. `git log` of this
# file is the complete prod deploy history; `git revert` rolls back.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
namespace: frontend
resources:
  - ../../base
  - ingress.yaml
images:
  - name: ghcr.io/[< registry_org >]/[< client_name >]-frontend
    newTag: sha-0000000 # promoted from staging via PR (proven in staging first)
