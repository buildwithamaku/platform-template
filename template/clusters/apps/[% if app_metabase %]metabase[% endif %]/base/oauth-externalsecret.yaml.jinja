# OAuth credentials for the oauth2-proxy SSO gate. ESO -> Infisical, no secrets in
# git. cookie-secret must decode to 16/24/32 BYTES — generate with
# `openssl rand -hex 16` (= 32 chars). NOT `openssl rand -base64 32` (44 chars —
# oauth2-proxy rejects it: "cookie_secret must be 16, 24, or 32 bytes").
#
# Infisical (/[< client_name >]):
#   METABASE_OAUTH_CLIENT_ID     — OIDC app client id (agency Google OIDC app)
#   METABASE_OAUTH_CLIENT_SECRET — OIDC app client secret
#   METABASE_OAUTH_COOKIE_SECRET — 32-char cookie-signing secret (openssl rand -hex 16)
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: metabase-oauth
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: infisical
    kind: ClusterSecretStore
  target:
    name: metabase-oauth
  data:
    - secretKey: client-id
      remoteRef:
        key: METABASE_OAUTH_CLIENT_ID
    - secretKey: client-secret
      remoteRef:
        key: METABASE_OAUTH_CLIENT_SECRET
    - secretKey: cookie-secret
      remoteRef:
        key: METABASE_OAUTH_COOKIE_SECRET
