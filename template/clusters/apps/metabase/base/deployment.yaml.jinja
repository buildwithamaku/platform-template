# Metabase (BI). Stores its own state in the metabase-db CNPG cluster (MB_DB_*
# from the generated metabase-db-app secret). The reloader annotation rolls it
# when that secret rotates. Product data sources (read-only, via the metabase_ro
# role) are added in the Metabase admin UI/API — that config is Metabase app state
# and lives in its app-db, not in k8s.
#
# Runs non-root (uid 2000) with emptyDir mounts for the writable paths Metabase
# needs (driver plugins + temp). Startup is slow (JVM + app-db migrations), hence
# the generous probe delays.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: metabase
  labels:
    app.kubernetes.io/name: metabase
    app.kubernetes.io/part-of: {{ client_name }}
  annotations:
    reloader.stakater.com/auto: "true"
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: metabase
  template:
    metadata:
      labels:
        app.kubernetes.io/name: metabase
        app.kubernetes.io/part-of: {{ client_name }}
    spec:
      securityContext:
        runAsNonRoot: true
        runAsUser: 2000
        runAsGroup: 2000
        fsGroup: 2000
      containers:
        - name: metabase
          # Pinned; verified running on the Hetzner e2e (2026-07-24). Bump deliberately.
          image: metabase/metabase:v0.52.8
          ports:
            - { containerPort: 3000, name: http }
          env:
            - { name: MB_DB_TYPE, value: postgres }
            - { name: MB_DB_HOST, value: metabase-db-rw }
            - { name: MB_DB_PORT, value: "5432" }
            - name: MB_DB_DBNAME
              valueFrom:
                secretKeyRef: { name: metabase-db-app, key: dbname }
            - name: MB_DB_USER
              valueFrom:
                secretKeyRef: { name: metabase-db-app, key: username }
            - name: MB_DB_PASS
              valueFrom:
                secretKeyRef: { name: metabase-db-app, key: password }
            - { name: MB_JETTY_PORT, value: "3000" }
            - { name: MB_PLUGINS_DIR, value: /plugins }
          volumeMounts:
            - { name: plugins, mountPath: /plugins }
            - { name: tmp, mountPath: /tmp }
          # Gate liveness/readiness until first boot finishes. Metabase's cold start
          # runs its own app-db migrations against a fresh CNPG cluster and can be
          # slow on modest storage; without this, liveness (~180s) can kill it
          # mid-migration -> crash-loop. kubelet holds liveness until startup passes.
          startupProbe:
            httpGet: { path: /api/health, port: http }
            periodSeconds: 10
            failureThreshold: 30 # up to ~5m for first-boot app-db migrations
          readinessProbe:
            httpGet: { path: /api/health, port: http }
            periodSeconds: 10
            failureThreshold: 3
          livenessProbe:
            httpGet: { path: /api/health, port: http }
            periodSeconds: 20
          resources:
            requests: { cpu: 250m, memory: 1Gi }
            limits: { memory: 2Gi }
      volumes:
        - { name: plugins, emptyDir: {} }
        - { name: tmp, emptyDir: {} }
