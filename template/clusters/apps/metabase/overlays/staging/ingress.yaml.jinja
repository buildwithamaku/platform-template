# Staging BI ingress -> oauth2-proxy (:4180) -> Metabase. LE STAGING issuer
# (untrusted cert, no rate limits). external-dns creates the DNS record from host.
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: metabase
  namespace: metabase
  annotations:
    cert-manager.io/cluster-issuer: letsencrypt-staging
spec:
  ingressClassName: nginx
  tls:
    - hosts:
        - bi.staging.{{ domain }}
      secretName: metabase-tls
  rules:
    - host: bi.staging.{{ domain }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: oauth2-proxy
                port:
                  number: 4180
