# Prod BI ingress -> oauth2-proxy (:4180) -> Metabase. LE PROD issuer (real
# green-lock cert). external-dns creates the DNS record from host.
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: metabase
  namespace: metabase
  annotations:
    cert-manager.io/cluster-issuer: letsencrypt-prod
spec:
  ingressClassName: nginx
  tls:
    - hosts:
        - bi.[< domain >]
      secretName: metabase-tls
  rules:
    - host: bi.[< domain >]
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: oauth2-proxy
                port:
                  number: 4180
