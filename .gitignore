# Platform factory: real inputs and generated artifacts stay local.
# Only *.example templates are tracked.
tofu/live/**/*.tfvars
tofu/live/**/backend.hcl
tofu/live/**/kubeconfig
tofu/**/.gen/
!tofu/**/*.tfvars.example

