# OpenTofu / Terraform
**/.terraform/*
.terraform.lock.hcl
*.tfstate
*.tfstate.*
crash.log
tfplan
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Platform factory: real inputs and generated artifacts stay local.
# Only *.example templates are tracked.
tofu/live/**/*.tfvars
tofu/live/**/backend.hcl
tofu/live/**/kubeconfig
tofu/**/.gen/
!tofu/**/*.tfvars.example

# Secrets: local env files with tokens/credentials never get committed.
.env
**/.env
!.env.example

# OS
.DS_Store
e2e/node_modules/

# node_modules anywhere (post copier-ize move)
**/node_modules/

# tofu state/secrets/local (patterns re-anchored after the copier template/ move)
**/.gen/
tofu/live/*/kubeconfig
**/terraform.tfvars
**/*.tfstate*
**/*.tfstate.backup
**/backend.hcl
**/.terraform/
